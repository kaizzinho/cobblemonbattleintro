{
  "schemaVersion": 1,
  "id": "kaizzinhobattleslider",
  "version": "${version}",
  "name": "Cobblemon Battle Slider",
  "description": "Pokémon-style VS battle slider animation for Cobblemon",
  "authors": [
    "Kaizzinho"
  ],
  "contact": {},
  "license": "Battle Slider Source-Available Permission License 1.0",
  "icon": "assets/battleslider/icon.png",
