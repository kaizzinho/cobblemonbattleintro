{
  "schemaVersion": 1,
  "id": "cobblemonbattleintroduction",
  "version": "${version}",
  "name": "Cobblemon Battle Introduction",
  "description": "Adds Pokémon-style VS battle introductions to Cobblemon with animated 3D portraits, optional 2D sprites, trainer battles, PvP, WildBoss, Legendary and Mythical encounters, and extensive customization.",
  "authors": [
    "kaizzinho"
  ],
  "contact": {
    "sources": "https://github.com/arthurc0sme/kaizzinhobattleslider",
    "issues": "https://github.com/arthurc0sme/kaizzinhobattleslider/issues"
  },
  "license": "Battle Introduction Source-Available Permission License 1.0",
  "icon": "assets/battleintroduction/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.kaizzinho.battleintroduction.client.BattleIntroductionDataGenerator"
    ],
    "client": [
      "com.kaizzinho.battleintroduction.client.BattleIntroductionClient"
    ],
    "main": [
      "com.kaizzinho.battleintroduction.BattleIntroduction"
    ],
    "modmenu": [
      "com.kaizzinho.battleintroduction.client.compat.BattleIntroductionModMenuIntegration"
    ]
  },
  "mixins": [
    "battleintroduction.mixins.json",
    {
      "config": "battleintroduction.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "cobblemon": ">=1.7.3 <1.8.0",
    "minecraft": "~1.21.1"
  },
  "suggests": {
    "modmenu": ">=11.0.0",
    "wildbosses": "*",
    "rctmod": "*"
  },
  "provides": [
    "kaizzinhobattleslider"
  ]
}
